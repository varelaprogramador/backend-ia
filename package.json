  "name": "INTEGRACAO - MATRA - I.Ackend",
  "main": "build/server.js",
  "description": "Backend da aplicação EAD10",
  "scripts": {
    "start": "cross-env NODE_ENV=production PORT=80 node .",
    "build": "npm run clean && cross-env NODE_ENV=production PORT=80 tsc -p tsconfig.prod.json && tsc-alias && npm run copy:generated",
    "clean": "npx rimraf build",
    "copy:generated": "npx cpx2 \"src/generated/**/*\" build/generated",
    "dev": "cross-env NODE_ENV=development PORT=3333 tsx watch src/server.ts",
    "db:optimize-json": "node scripts/create-gin-indexes.js"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
